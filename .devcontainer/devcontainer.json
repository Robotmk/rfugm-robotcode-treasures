{
  "name": "RobotCode Treasures",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "hostRequirements": {
    "cpus": 2
  },
  // The image already ships git, curl and jq. No Python environment is created on purpose: chapter 1 is about that.
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "bank service", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "d-biehl.robotcode",
        "ms-python.python",
        "tamasfe.even-better-toml",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "workbench.startupEditor": "readme",
        "git.autofetch": true
      }
    }
  }
}
